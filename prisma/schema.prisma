generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  email       String    @unique
  name        String?
  password    String?   // bcrypt hashed
  avatar      String?
  language    String    @default("id")
  role        String    @default("user") // user, admin, superadmin
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  posts                 Post[]
  creatorProfile        CreatorProfile?
  creatorRecipes        CreatorRecipe[]
  financeRecords        FinanceRecord[]
  financeBudgets        FinanceBudget[]
  financeGoals          FinanceGoal[]
  recurringTransactions  RecurringTransaction[]
  sessions              Session[]
  activityLogs          ActivityLog[]
  clickLogs             ClickLog[]
  aiAgentUsageLogs      AiAgentUsageLog[]
  notifications         Notification[]

  @@index([username])
  @@index([email])
  @@index([role])
  @@map("users")
}

// ── Session (JWT-based) ──────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ── Post (legacy) ─────────────────────────────────────────────

model Post {
  id        String    @id @default(cuid())
  title     String
  content   String?
  published Boolean   @default(false)
  authorId  String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

// ── Affiliate System ──────────────────────────────────────────

model AffiliateAccount {
  id              String    @id @default(cuid())
  platform        String
  affiliateId     String
  apiKey          String?
  baseUrlTemplate String
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  productLinks ProductLink[]

  @@map("affiliate_accounts")
}

model ProductLink {
  id             String    @id @default(cuid())
  productName    String
  category       String
  imageUrl       String?
  platform       String
  affiliateUrl   String
  originalPrice  Float?
  createdByAi    Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account   AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  clickLogs ClickLog[]

  @@map("product_links")
}

model ClickLog {
  id            String   @id @default(cuid())
  productLinkId String
  platform      String
  userId        String?
  context       String
  clickedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  productLink ProductLink @relation(fields: [productLinkId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productLinkId])
  @@index([userId])
  @@index([clickedAt])
  @@map("click_logs")
}

// ── Creator Feature ───────────────────────────────────────────

model CreatorRecipe {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  image       String    @default("")
  category    String    @default("Lainnya")
  difficulty  String    @default("Mudah")
  cookTime    Int       @default(30)
  prepTime    Int       @default(15)
  servings    Int       @default(4)
  ingredients String    @default("[]")
  steps       String    @default("[]")
  tags        String    @default("[]")
  youtubeUrl  String?
  likes       Int       @default(0)
  isPublished Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isPublished])
  @@map("creator_recipes")
}

model CreatorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String   @default("")
  bio          String   @default("")
  avatar       String   @default("")
  totalRecipes Int      @default(0)
  totalLikes   Int      @default(0)
  followers    Int      @default(0)
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

// ── Financial Planner Feature ─────────────────────────────────

model FinanceRecord {
  id          String   @id @default(cuid())
  userId      String
  type        String
  category    String
  amount      Float
  description String   @default("")
  date        DateTime @default(now())
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([date])
  @@map("finance_records")
}

model FinanceBudget {
  id          String   @id @default(cuid())
  userId      String
  category    String
  limitAmount Float
  spentAmount Float    @default(0)
  period      String
  startDate   DateTime @default(now())
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("finance_budgets")
}

model FinanceGoal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  targetAmount Float
  savedAmount  Float    @default(0)
  deadline     DateTime @default(now())
  icon         String   @default("")
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("finance_goals")
}

// ── AI Agent Management ───────────────────────────────────────

model AiAgent {
  id             String    @id @default(cuid())
  name           String
  provider       String
  model          String
  apiKey         String?
  apiBaseUrl     String?
  maxTokens      Int       @default(2000)
  usedTokens     Int       @default(0)
  totalRequests  Int       @default(0)
  failedRequests Int       @default(0)
  isActive       Boolean   @default(true)
  isDefault      Boolean   @default(false)
  description    String    @default("")
  purpose        String    @default("all")
  lastUsedAt     DateTime?
  lastError      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  usageLogs AiAgentUsageLog[]

  @@index([purpose])
  @@index([isActive])
  @@map("ai_agents")
}

model AiAgentUsageLog {
  id           String   @id @default(cuid())
  agentId      String
  userId       String?
  feature      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  status       String
  errorMsg     String?
  createdAt    DateTime @default(now())

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@map("ai_agent_usage_logs")
}

// ── Activity Log ──────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  detail    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ── System Setting ────────────────────────────────────────────

model SystemSetting {
  key       String @id
  value     String @default("")
  type      String @default("string") // string, number, boolean, json
  group     String @default("general") // general, security, ai, notification
  isPublic  Boolean @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_settings")
}

// ── Notification ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  category  String   @default("general") // general, finance, creator, ai, system
  isRead    Boolean  @default(false)
  link      String?  // optional deep link
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([category])
  @@index([createdAt])
  @@map("notifications")
}

// ── Recurring Transaction ───────────────────────────────────

model RecurringTransaction {
  id          String    @id @default(cuid())
  userId      String
  type        String    // income, expense
  category    String
  amount      Float
  description String    @default("")
  frequency   String    // daily, weekly, monthly, yearly
  nextDate    DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([frequency])
  @@index([nextDate])
  @@map("recurring_transactions")
}

// ── Recipe Rating / Comment ──────────────────────────────────

model RecipeRating {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  rating    Int      // 1-5
  comment   String   @default("")
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
  @@map("recipe_ratings")
}

// ── AI Token Quota / Alert ───────────────────────────────────

model AiTokenAlert {
  id            String   @id @default(cuid())
  agentId       String?
  thresholdType String   // total_tokens, daily_tokens, error_rate
  thresholdValue Float
  isTriggered   Boolean  @default(false)
  triggeredAt   DateTime?
  resolvedAt    DateTime?
  message       String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agentId])
  @@index([isTriggered])
  @@map("ai_token_alerts")
}